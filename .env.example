# ─── Servidor ───────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de Datos ─────────────────────
# Local: PostgreSQL en Docker
DATABASE_URL=postgresql://ecn_user:ecn_pass@localhost:5433/ecn_db

# Producción (Render): pegar Internal Database URL de Render PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/ecn

# ─── JWT ────────────────────────────────
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_EXPIRES_IN=24h

# ─── Bcrypt ─────────────────────────────
BCRYPT_SALT_ROUNDS=10
